{
  "name": "concrete-contractors-estimator",
  "displayName": "Concrete Contractors Estimator",
  "description": "Concrete contractors take-off in VS Code: slab, footing, column and steps volume in cubic yards, ready-mix order, 80/60/40 lb bag counts, rebar and mesh, rough cost. Insert results as a Markdown table. Offline, no telemetry.",
  "version": "1.0.0",
  "publisher": "nbkdevs",
  "author": { "name": "Phoenix Concrete Contractors", "url": "https://concretecontractorsphoenix.net/" },
  "license": "MIT",
  "icon": "icon.png",
  "homepage": "https://concretecontractorsphoenix.net/",
  "bugs": { "url": "https://concretecontractorsphoenix.net/" },
  "repository": { "type": "git", "url": "https://github.com/nbkdevs/concrete-contractors-phoenix.git", "directory": "packages/vscode" },
  "galleryBanner": { "color": "#7a3419", "theme": "dark" },
  "engines": { "vscode": "^1.74.0" },
  "categories": ["Other"],
  "keywords": ["concrete contractors", "concrete calculator", "cubic yards", "concrete bags", "rebar", "slab", "estimator", "markdown table"],
  "main": "./extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      { "command": "concreteContractorsEstimator.openEstimator", "title": "Open Estimator", "category": "Concrete Contractors" },
      { "command": "concreteContractorsEstimator.insertEstimate", "title": "Insert Concrete Estimate (Markdown Table)", "category": "Concrete Contractors" }
    ],
    "menus": {
      "editor/context": [
        { "command": "concreteContractorsEstimator.insertEstimate", "when": "editorLangId == markdown", "group": "z_commands" }
      ]
    },
    "configuration": {
      "title": "Concrete Contractors Estimator",
      "properties": {
        "concreteContractorsEstimator.wastePercent": { "type": "number", "default": 10, "minimum": 0, "maximum": 100, "description": "Waste and over-excavation allowance in percent added to the net volume." },
        "concreteContractorsEstimator.rebarSpacing": { "type": "number", "default": 18, "minimum": 4, "maximum": 48, "description": "Rebar grid spacing in inches on center for slabs." },
        "concreteContractorsEstimator.finish": { "type": "string", "default": "broom", "enum": ["broom", "colored", "exposed", "stamped"], "description": "Finish used for the rough installed cost range on slabs." }
      }
    }
  },
  "scripts": {
    "sync-core": "node scripts/sync-core.js",
    "compile": "node --check extension.js && node --check lib/report.js && node --check lib/panel.js && node --check lib/core.js && node --check media/panel.js",
    "test": "node --test test/*.test.js",
    "screenshot": "SIZE=1280,640 node scripts/screenshot.js",
    "vscode:prepublish": "npm run compile && npm test",
    "package": "npx --yes @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {}
}
