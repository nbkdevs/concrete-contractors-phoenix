<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>PhoenixConcreteContractors.Estimator</RootNamespace>
    <PackageId>PhoenixConcreteContractors.Estimator</PackageId>
    <Version>1.0.1</Version>
    <Title>Concrete Contractors Estimator</Title>
    <Authors>Phoenix Concrete Contractors</Authors>
    <Company>Phoenix Concrete Contractors</Company>
    <Description>Concrete contractors estimator for .NET: slab, driveway, footing, column and steps volume in cubic yards, 80/60/40 lb bag counts, rebar and mesh, rough cost range and hot-weather pour advice. No dependencies.</Description>
    <PackageTags>concrete;concrete-calculator;concrete-contractors;cubic-yards;slab;rebar;estimator;construction</PackageTags>
    <PackageProjectUrl>https://concretecontractorsphoenix.net/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/nbkdevs/concrete-contractors-phoenix</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
